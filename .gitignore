/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/
*.log

# Rider plugin, auto-generated
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# IDE and tool caches
.vs/
.vsconfig
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/

# Autogenerated solution and project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
