# Generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*
.dirstamp
tmpinst-dir.stamp

# Builds / player leftovers (large local bloat)
/*_BackUpThisFolder_ButDontShipItWithYourGame/
/*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.obb
*.unitypackage
*.unitypackage.meta
*.app
crashlytics-build.properties

# Addressables build output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

.DS_Store

# Unity 6 solution format
*.slnx

# Unity 6 build tool temp
/.utmp/

# Unity 6 Build Profiles: auto-created when the Build Profiles window opens.
# Default Android profile uses a trademark character (Android™) that breaks
# tools and dirties git; Tools/*_build_and_run.sh does not use these assets.
/[Aa]ssets/[Ss]ettings/[Bb]uild [Pp]rofiles/
/[Aa]ssets/[Ss]ettings/[Bb]uild [Pp]rofiles.meta

# Videos for local builds only (Tools/make_videos.sh copies them in); only the placeholders are in git
/[Aa]ssets/StreamingAssets/*.mp4
/[Aa]ssets/StreamingAssets/*.mp4.meta
!/[Aa]ssets/StreamingAssets/Sample_*.mp4
!/[Aa]ssets/StreamingAssets/Sample_*.mp4.meta
