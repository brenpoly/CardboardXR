# Normalize text for cross-machine Unity + git sync (Force Text serialization).
* text=auto eol=lf

# Source / shaders
*.cs text diff=csharp
*.shader text
*.cginc text
*.hlsl text
*.compute text
*.json text
*.xml text
*.txt text
*.md text
*.sh text eol=lf
*.zsh text eol=lf

